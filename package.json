{
  "name": "latexeditor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "tauri:build": "tauri build",
    "install": "tauri build && cp -rf src-tauri/target/release/bundle/macos/LaTeXEditor.app /Applications/ && open /Applications/LaTeXEditor.app",
    "lint": "oxlint",
    "test": "for f in src/lib/*.check.ts; do node --experimental-strip-types \"$f\" || exit 1; done && cd src-tauri && cargo test --lib",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dietrichgebert/ponytail": "^4.8.4",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "esbuild": "^0.28.1",
    "headroom-ai": "^0.22.4",
    "monaco-editor": "^0.55.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
